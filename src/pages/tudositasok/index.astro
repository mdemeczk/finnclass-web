---
import { getCollection } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
const reports = (await getCollection('reports', ({data}) => !data.draft)).sort((a,b) => b.data.date.valueOf()-a.data.date.valueOf());
const years = [...new Set(reports.map(r => r.data.year))].sort((a,b) => b-a);
const locations = [...new Set(reports.map(r => r.data.location))].sort((a,b) => a.localeCompare(b,'hu'));
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---
<MainLayout title="Helyszíni tudósítások | FinnClass.hu" description="Képes beszámolók a versenyek helyszínéről. Keresés helyszín és év szerint.">
  <Navbar />
  <main class="container section-space">
    <p class="eyebrow text-primary">A versenyek közelről</p>
    <h1>Helyszíni tudósítások</h1>
    <p class="text-secondary">Képes beszámolók, élmények és hírek a versenyek helyszínéről.</p>
    <form id="report-filters" class="row g-3 my-4" role="search" aria-label="Tudósítások keresése" hidden>
      <div class="col-md-5"><label for="report-location" class="form-label">Helyszín</label><select id="report-location" class="form-select"><option value="">Minden helyszín</option>{locations.map(l => <option value={l}>{l}</option>)}</select></div>
      <div class="col-md-3"><label for="report-year" class="form-label">Év</label><select id="report-year" class="form-select"><option value="">Minden év</option>{years.map(y => <option value={y}>{y}</option>)}</select></div>
      <div class="col-md-4 d-flex align-items-end"><button type="reset" class="btn btn-outline-primary">Szűrők törlése</button></div>
    </form>
    <p id="report-count" role="status" aria-live="polite">{reports.length} tudósítás</p>
    <div class="row g-4">
      {reports.map(r => <article class="col-md-6 col-lg-4" data-report data-location={r.data.location} data-year={r.data.year}>
        <div class="news-card h-100">
          {r.data.images[0] && <img class="news-image" src={`${base}${r.data.images[0].path.replace(/^\/+/, '')}`} alt={r.data.images[0].alt} loading="lazy" />}
          <p class="text-secondary">{r.data.location} · {r.data.year}</p>
          <h2 class="h4">{r.data.title}</h2><p>{r.data.excerpt}</p>
          <a href={`${base}tudositasok/${r.id}/`}>Tudósítás elolvasása</a>
        </div>
      </article>)}
    </div>
    <p id="report-empty" class="p-4 bg-light rounded" hidden={reports.length > 0}>{reports.length ? 'Nincs a kiválasztott feltételeknek megfelelő tudósítás.' : 'Hamarosan képes helyszíni tudósításokkal jelentkezünk.'}</p>
  </main><Footer />
</MainLayout>
<script>
  const form = document.querySelector<HTMLFormElement>('#report-filters')!;
  const location = document.querySelector<HTMLSelectElement>('#report-location')!;
  const year = document.querySelector<HTMLSelectElement>('#report-year')!;
  const cards = [...document.querySelectorAll<HTMLElement>('[data-report]')];
  const update = () => {
    let count = 0;
    for (const card of cards) {
      card.hidden = !!((location.value && card.dataset.location !== location.value) || (year.value && card.dataset.year !== year.value));
      if (!card.hidden) count++;
    }
    document.querySelector('#report-count')!.textContent = `${count} tudósítás`;
    document.querySelector<HTMLElement>('#report-empty')!.hidden = count > 0;
  };
  form.hidden = false;
  form.addEventListener('submit', e => e.preventDefault());
  form.addEventListener('change', update);
  form.addEventListener('reset', () => { location.value = ''; year.value = ''; update(); });
</script>
