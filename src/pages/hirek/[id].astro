---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const news = await getCollection('news', ({ data }) => !data.draft);
  return news.map((article) => ({ params: { id: article.id }, props: { article } }));
}

interface Props { article: CollectionEntry<'news'>; }
const { article } = Astro.props;
const { Content } = await render(article);
const dateFormatter = new Intl.DateTimeFormat('hu-HU', { year: 'numeric', month: 'long', day: 'numeric' });
const baseUrl = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const imageUrl = article.data.image ? `${baseUrl}${article.data.image.replace(/^\/+/, '')}` : undefined;
const canonicalPath = Astro.url.pathname.replace(/^\/finnclass-web(?=\/|$)/, '') || '/';
const pageUrl = new URL(canonicalPath, 'http://new.finnclass.hu').href;
const facebookGroupUrl = 'https://www.facebook.com/groups/finnclass.hu';
---

<MainLayout title={`${article.data.title} | FinnClass.hu`} description={article.data.excerpt}>
  <Navbar />
  <main>
    <header class="article-header text-white">
      <div class="container py-5">
        <a class="article-back" href={`${baseUrl}#hirek`}><i class="fa-solid fa-arrow-left me-2"></i>Vissza a hírekhez</a>
        <p class="eyebrow mt-5 mb-3">FinnClass hírek</p>
        <h1>{article.data.title}</h1>
        <time datetime={article.data.date.toISOString()}>{dateFormatter.format(article.data.date)}</time>
      </div>
    </header>
    <article class="article-content container section-space">
      <div class="mx-auto">
        {imageUrl && <img class="article-image" src={imageUrl} alt={article.data.imageAlt ?? ''} />}
        <Content />
        <aside class="mt-5 border-top pt-4" aria-labelledby="article-share-title">
          <h2 class="h5 mb-3" id="article-share-title">Oszd meg a közösséggel!</h2>
          <a class="btn btn-primary" data-article-group-share data-url={pageUrl} href={facebookGroupUrl} target="_blank" rel="noopener noreferrer"><i class="fa-brands fa-facebook me-2" aria-hidden="true"></i>Megosztás a Finnclass.hu csoportban</a>
          <small class="d-block mt-2 text-secondary" data-article-share-status role="status" aria-live="polite">A gomb kimásolja a cikk linkjét, és megnyitja a Facebook-csoportot.</small>
        </aside>
      </div>
    </article>
  </main>
  <Footer />
  <script>
    const articleShare = document.querySelector<HTMLAnchorElement>('[data-article-group-share]');
    const articleShareStatus = document.querySelector<HTMLElement>('[data-article-share-status]');
    if (articleShare && articleShareStatus) {
      const url = articleShare.dataset.url!;
      articleShare.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(url);
          articleShareStatus.textContent = 'A cikk linkjét kimásoltuk. Illeszd be a megnyíló csoport új bejegyzésébe!';
        } catch {
          articleShareStatus.textContent = `A csoport megnyílt. A megosztandó link: ${url}`;
        }
      });
    }
  </script>
</MainLayout>
