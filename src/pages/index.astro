---
import MainLayout from '../layouts/MainLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import News from '../components/News.astro';
import UpcomingRace from '../components/UpcomingRace.astro';
import Results from '../components/Results.astro';
import Gallery from '../components/Gallery.astro';
import Sponsors from '../components/Sponsors.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

const news = (await getCollection('news', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
const races = (await getCollection('races')).sort((a, b) => a.data.startDate.valueOf() - b.data.startDate.valueOf());
const results = (await getCollection('results')).sort((a, b) => a.data.ranking - b.data.ranking);
const sponsors = (await getCollection('sponsors')).sort((a, b) => a.data.order - b.data.order);
---

<MainLayout>
  <Navbar />
  <main>
    <Hero />
    <News news={news} />
    <UpcomingRace races={races} />
    <Results results={results} />
    <Gallery />
    <Sponsors sponsors={sponsors} />
  </main>
  <Footer />
</MainLayout>
