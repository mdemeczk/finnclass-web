---
import type { CollectionEntry } from 'astro:content';

interface Props { results: CollectionEntry<'results'>[]; }
const { results } = Astro.props;
const season = results[0]?.data.season ?? new Date().getFullYear();
---

<section class="section-space bg-light" id="eredmenyek">
  <div class="container">
    <div class="row g-5 align-items-center">
      <div class="col-lg-5">
        <p class="eyebrow text-primary mb-2">Legutóbbi eredmények</p>
        <h2 class="mb-3">Finn Ranglista {season}</h2>
        <p class="text-secondary mb-4">Az éves ranglista a hazai versenyeken elért eredmények alapján.</p>
        <a class="btn btn-primary" href="#eredmenyek">Teljes eredménylista <i class="fa-solid fa-arrow-right ms-2"></i></a>
      </div>
      <div class="col-lg-7">
        <div class="results-card">
          {results.map((result) => (
            <div class="result-row">
              <span class="place">{result.data.ranking}</span>
              <span class="result-name"><strong>{result.data.name}</strong><small>{result.data.sailNumber}</small></span>
              <strong class="ms-auto">{result.data.points} pont</strong>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
