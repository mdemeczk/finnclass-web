---
import rankings from '../data/rankings.json';
const years = [...new Set(rankings.map((r) => r.year))].sort((a, b) => b - a);
const baseUrl = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const points = new Intl.NumberFormat('hu-HU', { maximumFractionDigits: 2 });
---
<section class="section-space bg-light" id="eredmenyek">
  <div class="container">
    <p class="eyebrow text-primary mb-2">Eredmények</p>
    <h2 class="mb-3">Finn Országos Bajnokság 2026</h2>
    <p>Balatonföldvár, 2026. szeptember 17–20.</p>
    <div class="d-flex flex-wrap gap-2 mb-5">
      <a class="btn btn-primary" href={`${baseUrl}documents/FinnDinghyOB_R10__.pdf`} target="_blank" rel="noopener noreferrer">Végeredmény 10 futam után (PDF)</a>
      <a class="btn btn-outline-primary" href={`${baseUrl}galeria/#dobogok`}>Dobogós fényképek</a>
    </div>
    <section class="mb-5" id="nemzetkozi-versenyek" aria-labelledby="international-title">
      <h2 id="international-title" class="mb-3">Nemzetközi versenyek</h2>
      <h3 class="h4">International Finn Cup 2026 – Trofeo A. Menoni, 5th Italia Cup</h3>
      <p>Malcesine, Olaszország · 2026. október 2–4.</p>
      <p class="text-secondary">Végeredmény 6 futam után, egy kiejtővel. A PDF a 2026. október 4-én 11:57-kor közzétett eredményeket tartalmazza.</p>
      <p><strong>Két magyar az első tízben:</strong> Kaiser Kristóf 4., Kántor Zsigmond 8. Pallay Tibor a 11. helyen végzett.</p>
      <details class="mb-3">
        <summary>Magyar versenyzők helyezései (11 induló)</summary>
        <div class="table-responsive mt-3"><table class="table"><thead><tr><th scope="col">Helyezés</th><th scope="col">Versenyző</th><th scope="col">Vitorlaszám</th><th scope="col">Nettó pont</th></tr></thead><tbody>
          <tr><td>4.</td><td>Kaiser Kristóf</td><td>HUN 808</td><td>30</td></tr>
          <tr><td>8.</td><td>Kántor Zsigmond</td><td>HUN 30</td><td>57</td></tr>
          <tr><td>11.</td><td>Pallay Tibor</td><td>HUN 5</td><td>64</td></tr>
          <tr><td>17.</td><td>Gerencsér Gergely</td><td>HUN 180</td><td>96</td></tr>
          <tr><td>19.</td><td>Huszár Géza</td><td>HUN 1</td><td>116</td></tr>
          <tr><td>28.</td><td>Lukáts Ákos</td><td>HUN 50</td><td>144</td></tr>
          <tr><td>29.</td><td>Majthényi Zsombor</td><td>HUN 88</td><td>145</td></tr>
          <tr><td>56.</td><td>Horváth Zoltán</td><td>HUN 33</td><td>247</td></tr>
          <tr><td>70.</td><td>Mónus Gyula</td><td>HUN 972</td><td>295</td></tr>
          <tr><td>73.</td><td>Csorba Dávid</td><td>HUN 85</td><td>298</td></tr>
          <tr><td>85.</td><td>Csányi Zoltán</td><td>HUN 150</td><td>363</td></tr>
        </tbody></table></div>
      </details>
      <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-primary" href={`${baseUrl}documents/international-finn-cup-2026-vegeredmeny.pdf`} target="_blank" rel="noopener noreferrer">Végeredmény – 6 futam után (PDF)</a>
        <a class="btn btn-outline-primary" href="https://fragliavela.sailti.com/en/default/races/race-resultsall?text=international-finn-cup-2026-trofeo-a-menoni-5th-italia-cup-en" target="_blank" rel="noopener noreferrer">Aktuális eredmények a rendező oldalán</a>
      </div>
    </section>
    <h2 class="mb-3">Finn ranglisták</h2>
    <p class="text-secondary">Válassz évet és kategóriát! Az első három helyezett alatt a teljes ranglista PDF-ben is elérhető.</p>
    <div class="row g-3 mb-4" id="ranking-filters" hidden>
      <div class="col-sm-4 col-lg-3">
        <label for="ranking-year" class="form-label">Év</label>
        <select id="ranking-year" class="form-select">{years.map((year) => <option value={year}>{year}</option>)}</select>
      </div>
      <div class="col-sm-8 col-lg-5">
        <label for="ranking-category" class="form-label">Kategória</label>
        <select id="ranking-category" class="form-select"></select>
      </div>
    </div>
    <div aria-live="polite" aria-atomic="true">
      {rankings.map((ranking) => (
        <div data-ranking data-year={ranking.year} data-category={ranking.category} class="mb-4">
          <h3 class="h4 mb-3">{ranking.year} – {ranking.category}</h3>
          <div class="results-card mb-3">
            {ranking.leaders.map((leader, index) => (
              <div class="result-row">
                <span class="place">{index + 1}</span>
                <span class="result-name"><strong>{leader.name}</strong><small>{leader.club}</small></span>
                <strong class="ms-auto text-nowrap">{points.format(leader.points)} pont</strong>
              </div>
            ))}
          </div>
          <a class="btn btn-primary" href={`${baseUrl}documents/${ranking.pdf}`} target="_blank" rel="noopener noreferrer" aria-label={`Teljes eredménylista: ${ranking.year}, ${ranking.category} (PDF, új ablak)`}>Teljes eredménylista (PDF) <i class="fa-solid fa-arrow-right ms-2" aria-hidden="true"></i></a>
        </div>
      ))}
    </div>
  </div>
</section>
<script>
  const year = document.querySelector<HTMLSelectElement>('#ranking-year');
  const category = document.querySelector<HTMLSelectElement>('#ranking-category');
  const filters = document.querySelector<HTMLElement>('#ranking-filters');
  const panels = [...document.querySelectorAll<HTMLElement>('[data-ranking]')];
  if (year && category && filters) {
    const show = () => {
      for (const panel of panels) panel.hidden = panel.dataset.year !== year.value || panel.dataset.category !== category.value;
    };
    const updateCategories = () => {
      const previous = category.value;
      const available = panels.filter((panel) => panel.dataset.year === year.value).map((panel) => panel.dataset.category!);
      category.replaceChildren(...available.map((name) => new Option(name, name)));
      if (available.includes(previous)) category.value = previous;
      show();
    };
    year.addEventListener('change', updateCategories);
    category.addEventListener('change', show);
    updateCategories();
    filters.hidden = false;
  }
</script>
