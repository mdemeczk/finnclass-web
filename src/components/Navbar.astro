---
const baseUrl = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const links = [
  ['Hírek', `${baseUrl}#hirek`],
  ['Versenynaptár', `${baseUrl}#versenynaptar`],
  ['Eredmények', `${baseUrl}#eredmenyek`],
  ['Galéria', `${baseUrl}#galeria`],
  ['Kapcsolat', `${baseUrl}#kapcsolat`],
];
---

<header class="site-header sticky-top">
  <nav class="navbar navbar-expand-lg navbar-dark" aria-label="Fő navigáció">
    <div class="container">
      <a class="navbar-brand d-flex align-items-center gap-3" href={import.meta.env.BASE_URL} aria-label="FinnClass.hu kezdőlap">
        <span class="brand-mark" aria-hidden="true"><i class="fa-solid fa-sailboat"></i></span>
        <span>
          <strong class="d-block">FINNCLASS.HU</strong>
          <small>Magyar Finn Osztályszövetség</small>
        </span>
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainMenu" aria-controls="mainMenu" aria-expanded="false" aria-label="Navigáció megnyitása">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="mainMenu">
        <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-1">
          {links.map(([label, href]) => <li class="nav-item"><a class="nav-link" href={href}>{label}</a></li>)}
        </ul>
      </div>
    </div>
  </nav>
</header>
