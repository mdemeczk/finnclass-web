---
const baseUrl = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const pageUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
const facebookGroupUrl = 'https://www.facebook.com/groups/finnclass.hu';
---

<footer class="footer text-white" id="kapcsolat">
  <div class="container py-5">
    <div class="row g-4 align-items-start">
      <div class="col-lg-5">
        <div class="d-flex gap-3 align-items-center mb-3"><img class="footer-logo" src={`${baseUrl}images/finnclass-egyszeru-logo-szines1.png`} alt="Magyar Finn Osztályszövetség logó" /><strong class="fs-4">FINNCLASS.HU</strong></div>
        <p class="text-white-50">A Magyar Finn Osztályszövetség hivatalos közösségi oldala.</p>
      </div>
      <div class="col-6 col-lg-3">
        <h2 class="h6">Kapcsolat</h2>
        <ul class="list-unstyled footer-links"><li><i class="fa-regular fa-envelope me-2"></i>info@finnclass.hu</li><li><i class="fa-solid fa-location-dot me-2"></i>Magyarország</li></ul>
      </div>
      <div class="col-6 col-lg-4">
        <h2 class="h6">Kövess minket</h2>
        <div class="d-flex flex-column align-items-start gap-2">
          <a class="btn btn-outline-light btn-sm" href={facebookGroupUrl} target="_blank" rel="noopener noreferrer"><i class="fa-brands fa-facebook me-2" aria-hidden="true"></i>Finnclass Facebook-csoport</a>
          <a class="btn btn-outline-light btn-sm" data-facebook-group-share data-url={pageUrl} href={facebookGroupUrl} target="_blank" rel="noopener noreferrer"><i class="fa-solid fa-share-nodes me-2" aria-hidden="true"></i>Megosztás a Finnclass.hu csoportban</a>
          <small data-copy-status role="status" aria-live="polite"></small>
        </div>
      </div>
    </div>
  </div>
  <div class="footer-bottom py-3"><div class="container d-flex flex-wrap justify-content-between gap-2"><small>© 2026 Magyar Finn Osztályszövetség</small><small>Fair sailing. Fast sailing.</small></div></div>
</footer>

<script>
  const groupShare = document.querySelector<HTMLAnchorElement>('[data-facebook-group-share]');
  const status = document.querySelector<HTMLElement>('[data-copy-status]');
  if (groupShare && status) {
    const local = ['localhost', '127.0.0.1', '[::1]'].includes(location.hostname);
    const url = local ? groupShare.dataset.url! : `${location.origin}${location.pathname}`;
    groupShare.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(url);
        status.textContent = 'A linket kimásoltuk. Illeszd be a megnyíló csoport új bejegyzésébe!';
      } catch {
        status.textContent = `A csoport megnyílt. A megosztandó link: ${url}`;
      }
    });
  }
</script>
