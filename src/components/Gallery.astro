---
const baseUrl = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const galleryUrl = `${baseUrl}galeria/`;
const categories = [
  { id: 'boszelben', title: 'Bőszélben', image: 'images/bőszélben/web/2024-11-16 13-51-32.JPG' },
  { id: 'friss-szelben', title: 'Friss szélben', image: 'images/vb/2017—__VB-HUN6-rajtutan.jpg' },
  { id: 'rajtvonalon', title: 'A rajtvonalon', image: 'images/Rajtonalon/web/P1010019.JPG' },
  { id: 'dobogok', title: 'Dobogós pillanatok', image: 'images/dobogok/web/2026-09-20-finn-ob-img_1955.jpg' },
];
const assetUrl = (path: string) => `${baseUrl}${path.split('/').map(encodeURIComponent).join('/')}`;
---

<section class="section-space" id="galeria">
  <div class="container">
    <div class="section-heading d-flex justify-content-between align-items-end gap-3 mb-5">
      <div><p class="eyebrow text-primary mb-2">Pillanatok a vízről</p><h2>Finn életképek</h2></div>
      <a class="text-link d-none d-sm-inline-flex" href={galleryUrl}>Teljes galéria <i class="fa-solid fa-arrow-right"></i></a>
    </div>
    <div class="gallery-grid">
      {categories.map((category, index) => (
        <a class:list={['gallery-item', `gallery-${index + 1}`]} href={`${galleryUrl}#${category.id}`}>
          <img class="gallery-photo" src={assetUrl(category.image)} alt={category.title} loading="lazy" />
          <span class="gallery-photo-caption">{category.title}<small>Képek megtekintése</small></span>
        </a>
      ))}
    </div>
    <div class="d-sm-none mt-4"><a class="text-link" href={galleryUrl}>Teljes galéria <i class="fa-solid fa-arrow-right"></i></a></div>
  </div>
</section>

<style>
  .gallery-item { text-decoration:none; }
  .gallery-photo { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
  .gallery-photo-caption { position:absolute; bottom:0; left:0; width:100%; padding:2.5rem 1rem .8rem; background:linear-gradient(transparent,rgba(0,25,40,.9)); color:white; font-size:1rem; line-height:1.4; }
  .gallery-photo-caption small { display:block; font-size:.75rem; font-weight:400; margin-top:.2rem; }
</style>
