---
import type { CollectionEntry } from 'astro:content';

interface Props { sponsors: CollectionEntry<'sponsors'>[]; }
const { sponsors } = Astro.props;
---

<section class="sponsors py-5" aria-labelledby="sponsors-title">
  <div class="container text-center">
    <p class="eyebrow text-primary mb-4" id="sponsors-title">Partnereink</p>
    <div class="d-flex flex-wrap justify-content-center gap-4 gap-md-5">
      {sponsors.map((sponsor) => sponsor.data.url
        ? <a href={sponsor.data.url} target="_blank" rel="noreferrer"><i class={`fa-solid ${sponsor.data.icon}`}></i> {sponsor.data.name}</a>
        : <span><i class={`fa-solid ${sponsor.data.icon}`}></i> {sponsor.data.name}</span>
      )}
    </div>
  </div>
</section>
